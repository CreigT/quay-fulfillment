# Copy these into Vercel → Settings → Environment Variables.
# Then deploy. You do not need to edit React.

NEXT_PUBLIC_COMPANY_NAME=Quay
NEXT_PUBLIC_TAGLINE=You paid. Here is the door.
NEXT_PUBLIC_OWNER_NAME=Legal Owner
NEXT_PUBLIC_SUPPORT_EMAIL=owner@example.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_URL=https://aurora-autonomous-commerce.vercel.app
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_PRIORITY_PRICE=9

# Signing secret for unlock tokens. Use a long random string.
UNLOCK_SECRET=change-me-to-a-long-random-string

# Live money (optional). Leave empty to stay in demo mode.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
